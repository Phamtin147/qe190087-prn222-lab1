@model BusinessObjects.Product
@{
    ViewData["Title"] = "Delete Product";
}
<h1>Delete Product</h1>
<div class="alert alert-warning">Are you sure you want to delete @Model.ProductName?</div>
<form asp-action="Delete" method="post">
    <input asp-for="ProductId" type="hidden" />
    <button class="btn btn-danger">Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
