@model BusinessObjects.Product
@{
    ViewData["Title"] = "Edit Product";
}
<h1>Edit Product</h1>
<form asp-action="Edit" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input asp-for="ProductId" type="hidden" />
    <div class="mb-3"><label asp-for="ProductName" class="form-label"></label><input asp-for="ProductName" class="form-control" /></div>
    <div class="mb-3"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="UnitsInStock" class="form-label"></label><input asp-for="UnitsInStock" class="form-control" /></div>
    <div class="mb-3"><label asp-for="UnitPrice" class="form-label"></label><input asp-for="UnitPrice" class="form-control" /></div>
    <button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
