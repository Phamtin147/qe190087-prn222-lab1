@model BusinessObjects.Product
@{
    ViewData["Title"] = "Product Details";
}
<h1>Product Details</h1>
<dl class="row">
    <dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.ProductName</dd>
    <dt class="col-sm-2">Category</dt><dd class="col-sm-10">@Model.Category?.CategoryName</dd>
    <dt class="col-sm-2">Stock</dt><dd class="col-sm-10">@Model.UnitsInStock</dd>
    <dt class="col-sm-2">Price</dt><dd class="col-sm-10">@Model.UnitPrice.ToString("C")</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-secondary">Back</a>
